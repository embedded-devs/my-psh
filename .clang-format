BasedOnStyle: Microsoft # Google|Chromium|Mozilla|WebKit|Microsoft|GNU

# 头文件排序
SortIncludes: false
IncludeCategories:
  - Regex: "^<.*>"
    Priority: 1
  - Regex: "^\".*\""
    Priority: 2

# 从switch语句开始，缩进大小写标记一个级别。
IndentCaseLabels: true

# 使预处理指令（如 #if）与其内部的代码块保持相同的缩进层级。
IndentPPDirectives: None

# 函数定义左花括号不换行，控制语句(if/for/while等)左花括号不换行
BreakBeforeBraces: Custom
BraceWrapping:
  AfterClass: false
  AfterNamespace: false # 命名空间后换行
  AfterStruct: false
  AfterFunction: false # 函数花括号与函数名在同一行
  AfterControlStatement: Never # if/for/while 等 { 不换行
  AfterExternBlock: false # extern "C" { 与 extern 同行
# 对齐连续的宏定义
AlignConsecutiveMacros:
  Enabled: true # 启用宏定义对齐功能
  AcrossEmptyLines: true # 跨越空行对齐，即使宏定义之间有空行也会对齐
  AcrossComments: true # 跨越注释对齐，即使宏定义之间有注释行也会对齐
  AlignCompound: false # 不对齐复合赋值操作符（如 +=, -= 等）
  AlignFunctionPointers: false # 不对齐函数指针声明
  PadOperators: true # 在操作符两侧添加空格以对齐

# 对齐行尾注释（跨空行也对齐）
AlignTrailingComments:
  Kind: Always
  OverEmptyLines: 1

# 对齐c++类中的成员变量
AlignConsecutiveDeclarations: true

# 命名空间缩进配置
NamespaceIndentation: All

# 缩进宽度（如 2、4）
IndentWidth: 4
